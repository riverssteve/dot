{{- $isWork := eq .chezmoi.os "darwin" -}}
{{- $shell := "fish" -}}
{{- if and (eq .chezmoi.os "linux") (or (hasPrefix "pi-" .chezmoi.hostname) (hasPrefix "raspberry" .chezmoi.hostname)) -}}
  {{- $shell = "bash" -}}
{{- end -}}

[data]
isWork = {{ $isWork }}
shell = {{ $shell | quote }}
# Set this after importing your signing key on each machine.
signingKey = ""
