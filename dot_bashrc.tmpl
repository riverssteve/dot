# Interactive Bash configuration; safe to source from a login shell too.
case $- in *i*) ;; *) return ;; esac

for file in "$HOME"/.config/bash/*.bash "$HOME"/.bashrc.d/*.sh; do
    # shellcheck disable=SC1090
    [ ! -r "$file" ] || . "$file"
done
unset file

for file in "$HOME"/.config/bash/secrets.local "$HOME"/.config/bash/extras.local; do
    # shellcheck disable=SC1090
    [ ! -r "$file" ] || . "$file"
done
unset file
