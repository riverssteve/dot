{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

if [ "$(id -u)" = "0" ]; then sudo() { "$@"; }; fi

{{ if or (eq .chezmoi.osRelease.id "bazzite") (eq .chezmoi.osRelease.id "fedora") -}}
FISH_PATH="$(command -v {{ .shell }} 2>/dev/null || echo /home/linuxbrew/.linuxbrew/bin/{{ .shell }})"
{{ else -}}
FISH_PATH="$(command -v {{ .shell }} 2>/dev/null || true)"
{{ end -}}

if [ ! -x "$FISH_PATH" ]; then
    echo "{{ .shell }} not found, skipping shell setup"
    exit 0
fi

if ! grep -qxF "$FISH_PATH" /etc/shells; then
    echo "Adding $FISH_PATH to /etc/shells..."
    echo "$FISH_PATH" | sudo tee -a /etc/shells
fi

if [ "${SHELL:-}" != "$FISH_PATH" ]; then
    echo "Setting default shell to $FISH_PATH..."
    sudo usermod -s "$FISH_PATH" "$(id -un)"
fi
{{- end }}
