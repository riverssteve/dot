{{- if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "bazzite") (eq .chezmoi.osRelease.id "fedora"))) -}}
#!/usr/bin/env bash
# Install Homebrew packages from Brewfile

set -euo pipefail

{{ template "brew-setup.sh" . }}

{{ if eq .chezmoi.os "darwin" -}}
manifest="$HOME/Caskfile"
{{ else -}}
manifest="$HOME/Brewfile"
{{ end -}}
if [ -f "$manifest" ]; then
    echo "Installing packages from $manifest..."
    brew bundle --file="$manifest"
    echo "✓ Homebrew packages installed successfully!"
else
    echo "Error: $manifest not found"
    exit 1
fi
{{- end }}
