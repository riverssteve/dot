# Set paths before initializing tools installed by Homebrew or mise.
if test -x /opt/homebrew/bin/brew
    /opt/homebrew/bin/brew shellenv | source
else if test -x /home/linuxbrew/.linuxbrew/bin/brew
    /home/linuxbrew/.linuxbrew/bin/brew shellenv | source
else if test -x /usr/local/bin/brew
    /usr/local/bin/brew shellenv | source
end

fish_add_path ~/.local/bin ~/.cargo/bin ~/.local/share/mise/shims

{{ if eq .chezmoi.os "darwin" -}}
if command -q brew
    set -l brew_prefix (brew --prefix)
    fish_add_path $brew_prefix/opt/coreutils/libexec/gnubin $brew_prefix/opt/fzf/bin $brew_prefix/opt/binutils/bin
end
{{ end -}}

if status is-interactive
    if command -v atuin >/dev/null
        atuin init fish | source
    end

    if command -v starship >/dev/null
        starship init fish | source
    end

    if command -v uv >/dev/null
        uv generate-shell-completion fish | source
    end

    if command -v zoxide >/dev/null
        zoxide init fish | source
    end

    if command -q mise
        mise activate fish | source
    end

    if command -q direnv
        direnv hook fish | source
    end
end

# Environment
set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx PROJECTS "$HOME/code"
set -g fish_greeting ""
if status is-interactive; and isatty stdin
    set -gx GPG_TTY (tty)
end

# FZF theme
set -gx FZF_DEFAULT_OPTS $FZF_DEFAULT_OPTS \
    --highlight-line \
    --info=inline-right \
    --ansi \
    --layout=reverse \
    --border=none \
    --color=bg+:#283457 \
    --color=bg:#16161e \
    --color=border:#27a1b9 \
    --color=fg:#c0caf5 \
    --color=gutter:#16161e \
    --color=header:#ff9e64 \
    --color=hl+:#2ac3de \
    --color=hl:#2ac3de \
    --color=info:#545c7e \
    --color=marker:#ff007c \
    --color=pointer:#ff007c \
    --color=prompt:#2ac3de \
    --color=query:#c0caf5:regular \
    --color=scrollbar:#27a1b9 \
    --color=separator:#ff9e64 \
    --color=spinner:#ff007c

# Local overrides
if test -f $HOME/.config/fish/secrets.fish
    source $HOME/.config/fish/secrets.fish
end

if test -f $HOME/.config/fish/extras.fish
    source $HOME/.config/fish/extras.fish
end
